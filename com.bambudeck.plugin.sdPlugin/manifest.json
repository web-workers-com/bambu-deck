					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.alert",
			"Name": "Alarm-Taste",
			"Tooltip": "Teil des Alarm-Profils. Ohne eingerichteten Drucker zeigt es die Anleitung.",
			"Icon": "imgs/actions/printer/icon",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"VisibleInActionsList": false,
			"States": [
				{
					"Image": "imgs/actions/printer/key",
					"ShowTitle": false
				}
			],
			"PropertyInspectorPath": "ui/setup.html"
		}
