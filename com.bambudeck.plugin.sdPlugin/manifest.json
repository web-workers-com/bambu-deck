{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Bambu Deck",
	"Version": "0.1.7.0",
	"Author": "Bambu Deck",
	"Description": "Watch less. Print more. Bao the panda watches your Bambu Lab printers: progress, AMS spools, temperatures, and the whole deck when a print is done or needs you. Runs on your LAN. Unofficial, not affiliated with Bambu Lab.",
	"Category": "Bambu Deck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://bambu-deck.com",
	"CodePath": "bin/plugin.js",
	"UUID": "com.bambudeck.plugin",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"UUID": "com.bambudeck.plugin.printer",
			"Name": "Bao (Drucker)",
			"Tooltip": "Zeigt, wie es dem Drucker geht: schläft, heizt, druckt, fertig, Fehler. Drücken wechselt Prozent, Restzeit und Schicht. Hier richtest du auch deine Drucker ein.",
			"Icon": "imgs/actions/printer/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/printer.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/printer/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.tray",
			"Name": "AMS-Spule",
			"Tooltip": "Eine Spule im AMS (A1 bis D4, HT, extern): Farbe, Material und wie viel noch drauf ist.",
			"Icon": "imgs/actions/tray/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/tray.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/tray/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.humidity",
			"Name": "AMS-Feuchte",
			"Tooltip": "Feuchte im AMS, beim AMS 2 Pro und AMS HT auch die Trockenzeit.",
			"Icon": "imgs/actions/humidity/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/humidity.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/humidity/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.temp",
			"Name": "Temperaturen",
			"Tooltip": "Düse, Bett oder Kammer.",
			"Icon": "imgs/actions/temp/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/temp.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/temp/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.pause",
			"Name": "Pause / Weiter",
			"Tooltip": "Hält den Druck an oder setzt ihn fort.",
			"Icon": "imgs/actions/pause/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/control.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/pause/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.stop",
			"Name": "Stopp (halten)",
			"Tooltip": "Bricht den Druck ab, aber nur, wenn du die Taste zwei Sekunden hältst.",
			"Icon": "imgs/actions/stop/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/control.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/stop/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.light",
			"Name": "Kammerlicht",
