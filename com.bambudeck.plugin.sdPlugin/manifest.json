			"Icon": "imgs/actions/light/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/control.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/light/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.speed",
			"Name": "Tempo",
			"Tooltip": "Wechselt Leise, Standard und Sport (Ludicrous auf Wunsch).",
			"Icon": "imgs/actions/speed/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/speed.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/speed/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.camera",
			"Name": "Kamera",
			"Tooltip": "Drücken zeigt das Live-Bild des Druckers über das ganze Deck. Noch ein Druck führt zurück.",
			"Icon": "imgs/actions/camera/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/camera.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/camera/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.controls",
			"Name": "Steuern",
			"Tooltip": "Drücken legt alle Steuerungen des Druckers über das ganze Deck: Pause, Stopp, Licht, Tempo, Vorheizen, Lüfter, Achsen, Filament.",
			"Icon": "imgs/actions/controls/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/controls.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/controls/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.preheat",
			"Name": "Vorheizen",
			"Tooltip": "Heizt Düse und Bett auf PLA, PETG, ABS/ASA oder TPU vor, oder kühlt ab. Noch ein Druck schaltet aus. Nur wenn nicht gedruckt wird.",
			"Icon": "imgs/actions/preheat/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/preheat.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
