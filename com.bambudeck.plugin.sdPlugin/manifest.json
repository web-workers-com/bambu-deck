					"Image": "imgs/actions/dial/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bambudeck.plugin.test",
			"Name": "Alarm testen",
			"Tooltip": "Löst einen Beispiel-Alarm aus, damit du siehst, wie das Deck reagiert.",
